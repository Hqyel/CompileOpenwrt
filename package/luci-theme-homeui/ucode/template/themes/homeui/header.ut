{%
  import { getuid, getspnam } from 'luci.core';

  const boardinfo = ubus.call('system', 'board');

  http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
  <head>
    <meta charset="utf-8">
    <title>{{ striptags(`${boardinfo.hostname ?? '?'}${
      dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="darkreader-lock">
    <meta name="theme-color" content="#2f89ff">
    <script>
      (function() {
        var savedMode = localStorage.getItem('homeui-color-mode') || 'auto';
        var darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
        var isDark = savedMode === 'dark' ||
          (savedMode === 'auto' && darkQuery.matches);

        document.documentElement.dataset.colorMode = savedMode;
        document.documentElement.dataset.darkmode = isDark ? 'true' : 'false';

        if (localStorage.getItem('homeui-sidebar') === 'collapsed')
          document.documentElement.classList.add('homeui-collapsed');
      })();
    </script>
    <link rel="stylesheet" href="{{ media }}/cascade.css">
    <link rel="stylesheet"
      media="only screen and (max-width: 900px)"
      href="/luci-static/bootstrap/mobile.css">
    <link rel="stylesheet"
      media="only screen and (max-width: 900px)"
      href="{{ media }}/mobile.css">
    <link rel="icon" href="{{ media }}/logo.svg" sizes="any">
    {% if (node?.css): %}
      <link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
    {% endif %}
    {% if (css): %}
      <style title="text/css">{{ css }}</style>
    {% endif %}
    <script src="{{ dispatcher.build_url(
      'admin/translations', dispatcher.lang) }}"></script>
    <script src="{{ resource }}/cbi.js"></script>
  </head>

  <body class="lang_{{ dispatcher.lang }} {{
    entityencode(striptags(node?.title ?? ''), true) }}"
    data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
    {% if (!blank_page): %}
      <header class="homeui-shell">
        <div class="homeui-brand">
          <a class="homeui-brand-link" href="{{
            dispatcher.build_url('admin/status/overview') }}">
            <img src="{{ media }}/logo.svg" alt="">
            <span>
              <strong>HomeUI</strong>
              <small>{{ striptags(boardinfo.hostname ?? '?') }}</small>
            </span>
          </a>
          <button id="homeui-collapse" type="button"
            aria-label="{{ _('Toggle navigation') }}">
            <span></span><span></span><span></span>
          </button>
        </div>

        <nav class="homeui-rail" aria-label="{{ _('Main menu') }}">
          <ul id="topmenu"></ul>
        </nav>

        <nav class="homeui-panel" aria-label="{{ _('Secondary menu') }}">
          <div class="homeui-panel-heading">
            <span id="homeui-section-icon"></span>
            <strong id="homeui-section-title">{{ _('Overview') }}</strong>
          </div>
          <ul id="sidemenu"></ul>
          <div class="homeui-panel-footer">
            <button id="homeui-color-toggle" type="button">
              <span class="homeui-color-icon"></span>
              <span class="homeui-color-label">{{ _('Appearance') }}</span>
            </button>
            <div id="indicators"></div>
            <ul id="modemenu" style="display:none"></ul>
          </div>
        </nav>
      </header>

      <div id="maincontent" class="container">
        {% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
          <div class="alert-message warning">
            <h4>{{ _('No password set!') }}</h4>
            <p>{{ _('There is no password set on this router. Please '
              + 'configure a root password to protect the web interface.')
              }}</p>
            {% if (dispatcher.lookup('admin/system/admin')): %}
              <div class="right">
                <a class="btn"
                  href="{{ dispatcher.build_url('admin/system/admin') }}">
                  {{ _('Go to password configuration...') }}
                </a>
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if (boardinfo.rootfs_type == 'initramfs'): %}
          <div class="alert-message warning">
            <h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
            <p>{{ _('No changes to settings will be stored and are lost '
              + 'after rebooting. This mode should only be used to install '
              + 'a firmware upgrade') }}</p>
            {% if (dispatcher.lookup('admin/system/flash')): %}
              <div class="right">
                <a class="btn"
                  href="{{ dispatcher.build_url('admin/system/flash') }}">
                  {{ _('Go to firmware upgrade...') }}
                </a>
              </div>
            {% endif %}
          </div>
        {% endif %}

        <noscript>
          <div class="alert-message warning">
            <h4>{{ _('JavaScript required!') }}</h4>
            <p>{{ _('You must enable JavaScript in your browser or LuCI '
              + 'will not work properly.') }}</p>
          </div>
        </noscript>

        <div id="tabmenu" style="display:none"></div>
    {% endif %}
