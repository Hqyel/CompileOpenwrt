{%
  import { getuid, getspnam } from 'luci.core';

  const boardinfo = ubus.call('system', 'board');

  http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
  <head>
    <meta charset="utf-8">
    <title>{{ striptags(`${boardinfo.hostname ?? '?'}${
      dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="darkreader-lock">
    <meta name="theme-color" content="#2f89ff">
    <script>
      (function() {
        var savedMode = localStorage.getItem('homeui-color-mode') || 'auto';
        var darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
        var isDark = savedMode === 'dark' ||
          (savedMode === 'auto' && darkQuery.matches);

        document.documentElement.dataset.colorMode = savedMode;
        document.documentElement.dataset.darkmode = isDark ? 'true' : 'false';

        if (localStorage.getItem('homeui-sidebar') === 'collapsed')
          document.documentElement.classList.add('homeui-collapsed');
      })();
    </script>
    <link rel="stylesheet"
      href="{{ media }}/cascade.css?v=@HOMEUI_VERSION@">
    <link rel="stylesheet"
      href="{{ media }}/overview.css?v=@HOMEUI_VERSION@">
    <link rel="stylesheet"
      media="only screen and (max-width: 900px)"
      href="/luci-static/bootstrap/mobile.css">
    <link rel="stylesheet"
      media="only screen and (max-width: 900px)"
      href="{{ media }}/mobile.css?v=@HOMEUI_VERSION@">
    <link rel="icon"
      href="{{ media }}/logo.svg?v=@HOMEUI_VERSION@" sizes="any">
    {% if (node?.css): %}
      <link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
    {% endif %}
    {% if (css): %}
      <style title="text/css">{{ css }}</style>
    {% endif %}
    <script src="{{ dispatcher.build_url(
      'admin/translations', dispatcher.lang) }}"></script>
    <script src="{{ resource }}/cbi.js"></script>
  </head>

  <body class="lang_{{ dispatcher.lang }} {{
    entityencode(striptags(node?.title ?? ''), true) }}"
    data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
    {% if (!blank_page): %}
      <header class="homeui-shell">
        <div class="homeui-brand">
          <div class="homeui-brand-row">
            <a class="homeui-brand-link" href="{{
              dispatcher.build_url('admin/status/overview') }}">
              <strong class="homeui-brand-wordmark">HomeUI</strong>
              <small class="homeui-brand-badge">{{
                striptags(boardinfo.hostname ?? 'HomeWrt')
              }}</small>
            </a>
            <a class="homeui-user-entry"
              href="{{ dispatcher.build_url('admin/system/admin') }}"
              title="{{ _('Administration') }}"
              aria-label="{{ _('Administration') }}">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="8" r="3.6"></circle>
                <path d="M5.5 19.5a6.5 6.5 0 0 1 13 0"></path>
              </svg>
            </a>
          </div>
          <button id="homeui-search-trigger" class="homeui-search-pill"
            type="button" title="Ctrl + K">
            <svg class="homeui-search-icon" viewBox="0 0 24 24"
              aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4.2 4.2"></path>
            </svg>
            <span class="homeui-search-shortcut">
              <kbd>Ctrl</kbd><span>+</span><kbd>K</kbd>
            </span>
          </button>
        </div>

        <div class="homeui-rail-col">
          <nav class="homeui-rail" aria-label="{{ _('Main menu') }}">
            <ul id="topmenu"></ul>
          </nav>

          <div class="homeui-global-tools">
            <div class="homeui-rail-Quicklinks">
              <a class="homeui-rail-util" data-rail-item="processes"
                href="{{ dispatcher.build_url('admin/status/processes') }}">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="4" y="3" width="16" height="18" rx="2.5"></rect>
                  <path d="M8 8h8M8 12h8M8 16h5"></path>
                </svg>
                <span>{{ _('Processes') }}</span>
              </a>
              <a class="homeui-rail-util" data-rail-item="logs"
                href="{{ dispatcher.build_url('admin/status/logs') }}">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z"></path>
                  <path d="M8 13h8M8 16h5"></path>
                </svg>
                <span>{{ _('System Log') }}</span>
              </a>
              <a class="homeui-rail-util" data-rail-item="system"
                href="{{ dispatcher.build_url('admin/system/system') }}">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21h-4v-.2a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.6-1H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6 1.7 1.7 0 0 0 10 3v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1z"></path>
                </svg>
                <span>{{ _('System') }}</span>
              </a>
            </div>
            <div class="homeui-rail-bottombar">
              <button id="homeui-collapse" type="button"
                title="{{ _('Toggle navigation') }}"
                aria-label="{{ _('Toggle navigation') }}">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 5v14"></path>
                  <path d="m14 8-4 4 4 4"></path>
                  <path d="M10 12h10"></path>
                </svg>
              </button>
              <button id="homeui-color-toggle" type="button"
                title="{{ _('Appearance') }}">
                <span class="homeui-color-icon"></span>
                <span class="homeui-color-label">{{ _('Appearance') }}</span>
              </button>
              <div id="indicators"></div>
              <div id="homeui-logout-slot"></div>
            </div>
          </div>
        </div>

        <nav class="homeui-panel" aria-label="{{ _('Secondary menu') }}">
          <ul id="sidemenu"></ul>
          <div class="homeui-panel-footer">
            <ul id="modemenu" style="display:none"></ul>
          </div>
        </nav>
      </header>

      <div id="maincontent" class="container">
        {% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
          <div class="alert-message warning">
            <h4>{{ _('No password set!') }}</h4>
            <p>{{ _('There is no password set on this router. Please '
              + 'configure a root password to protect the web interface.')
              }}</p>
            {% if (dispatcher.lookup('admin/system/admin')): %}
              <div class="right">
                <a class="btn"
                  href="{{ dispatcher.build_url('admin/system/admin') }}">
                  {{ _('Go to password configuration...') }}
                </a>
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if (boardinfo.rootfs_type == 'initramfs'): %}
          <div class="alert-message warning">
            <h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
            <p>{{ _('No changes to settings will be stored and are lost '
              + 'after rebooting. This mode should only be used to install '
              + 'a firmware upgrade') }}</p>
            {% if (dispatcher.lookup('admin/system/flash')): %}
              <div class="right">
                <a class="btn"
                  href="{{ dispatcher.build_url('admin/system/flash') }}">
                  {{ _('Go to firmware upgrade...') }}
                </a>
              </div>
            {% endif %}
          </div>
        {% endif %}

        <noscript>
          <div class="alert-message warning">
            <h4>{{ _('JavaScript required!') }}</h4>
            <p>{{ _('You must enable JavaScript in your browser or LuCI '
              + 'will not work properly.') }}</p>
          </div>
        </noscript>

        <div id="tabmenu" style="display:none"></div>
    {% endif %}
