#!/bin/sh

uci -q batch <<'EOF'
set system.@system[0].hostname='HomeWrt'
set system.@system[0].zonename='Asia/Shanghai'
set system.@system[0].timezone='CST-8'

set network.br_lan='device'
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
delete network.br_lan.ports
add_list network.br_lan.ports='eth0'

set network.lan='interface'
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='10.10.10.2'
set network.lan.netmask='255.255.255.0'
set network.lan.gateway='10.10.10.1'
delete network.lan.dns
add_list network.lan.dns='10.10.10.1'

delete network.wan
delete network.wan6
set network.wan6='interface'
set network.wan6.device='br-lan'
set network.wan6.proto='dhcpv6'
set network.wan6.reqaddress='try'
set network.wan6.reqprefix='no'

set dhcp.lan.ignore='1'
set dhcp.lan.dhcpv4='disabled'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ra='disabled'
set dhcp.lan.ndp='disabled'

set firewall.Allow_WireGuard_Inbound='rule'
set firewall.Allow_WireGuard_Inbound.name='Allow-WireGuard-Inbound'
set firewall.Allow_WireGuard_Inbound.src='wan'
set firewall.Allow_WireGuard_Inbound.proto='udp'
set firewall.Allow_WireGuard_Inbound.dest_port='51820'
set firewall.Allow_WireGuard_Inbound.family='ipv6'
set firewall.Allow_WireGuard_Inbound.target='ACCEPT'
EOF

uci commit system
uci commit network
uci commit dhcp
uci commit firewall

/etc/init.d/vlmcsd disable 2>/dev/null || true

exit 0


